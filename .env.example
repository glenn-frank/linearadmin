# Linear Admin API Keys
# Copy this file to .env and fill in your actual API keys

# Linear API Configuration
LINEAR_API_KEY=your_linear_api_key_here
LINEAR_TEAM_ID=your_team_id_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# AssemblyAI Configuration (for video processing)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Laravel Forge API Configuration
FORGE_API_KEY=your_forge_api_key_here

# Cloud MCP Server Configuration
PORT=3000
MCP_API_KEY=your_secure_api_key_for_cursor_auth
